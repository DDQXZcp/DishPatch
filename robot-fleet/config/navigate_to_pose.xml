<root BTCPP_format="4">
  <!--
    Minimal navigation tree: plan a path, then follow it.

    ComputePathToPose is wrapped in a retry because its failure mode here is not
    "no route exists" — it is "planner_server did not acknowledge the request in
    time". That is a transient timing race against a loaded host, and retrying it
    costs one extra round trip. Without the retry a single missed acknowledgement
    fails the Sequence, which fails the tree, which aborts the whole navigation
    goal before the robot has moved. Two robots were stranded that way on
    2026-08-11.

    Recovery *behaviors* (spin, back up, wait) are still deliberately absent: they
    would need a behavior_server, which multi_nav2_launch.py does not start. A
    retry decorator is plain behavior-tree logic and needs no extra node.
  -->
  <BehaviorTree ID="MainBT">
    <Sequence>
      <RetryUntilSuccessful num_attempts="3">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      </RetryUntilSuccessful>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </Sequence>
  </BehaviorTree>
</root>
