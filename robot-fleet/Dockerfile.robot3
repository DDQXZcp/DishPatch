# ── Standalone robot container ────────────────────────────────────────────────
# A whole robot in one image: the robot packages, its own Nav2 stack, and the
# rosbridge relay. Built for a robot that runs away from the fleet — a laptop or
# WSL box joining the EC2 rosbridge over the internet.
#
# Larger than Dockerfile.robot (~1.2GB more, for nav2-bringup) because Nav2 runs
# here rather than in the shared nav2 container. That is the point: only
# /status, /goal_pose and the Nav2 action status cross the network, while tf,
# odom and the costmaps stay in this container.
#
# The map must be staged before building:  map-source/stage-map-assets.sh
# ──────────────────────────────────────────────────────────────────────────────
FROM ros:jazzy-ros-base

SHELL ["/bin/bash", "-c"]

ENV ROS_DISTRO=jazzy
ENV PYTHONUNBUFFERED=1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

WORKDIR /ros2_ws

# ── System dependencies ────────────────────────────────────────────────────────
# python3-websocket is the relay's WebSocket client; apt rather than pip, since
# Ubuntu 24.04 marks its Python environment externally managed.
RUN apt-get update && apt-get install -y \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-websocket \
    ros-jazzy-tf2-ros \
    ros-jazzy-nav-msgs \
    ros-jazzy-nav2-msgs \
    ros-jazzy-nav2-bringup \
    ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# ── rosdep initialisation ──────────────────────────────────────────────────────
RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi

# ── Copy workspace source (robot packages + Nav2 launcher + relay) ─────────────
COPY src/shared_msgs ./src/shared_msgs
COPY src/robot_bringup ./src/robot_bringup
COPY src/robot_hardware ./src/robot_hardware
COPY src/robot_location_publisher ./src/robot_location_publisher
COPY src/robot_navigation ./src/robot_navigation
COPY src/robot_status ./src/robot_status
COPY src/nav2_launcher ./src/nav2_launcher
COPY src/rosbridge_relay ./src/rosbridge_relay
COPY config ./config
COPY scripts/robot3_entrypoint.sh ./scripts/robot3_entrypoint.sh
RUN chmod +x /ros2_ws/scripts/robot3_entrypoint.sh

# ── Install ROS dependencies declared in package.xml files ────────────────────
# python3-websocket is skipped rather than resolved: apt installed it above, and
# the key is not in every rosdep index — an unresolvable key fails the build.
RUN rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y \
      --skip-keys "python3-websocket"

# ── Build workspace ────────────────────────────────────────────────────────────
# shared_msgs (CMake) must be built first so the Python packages that depend
# on its generated interfaces can find them at build time.
RUN source /opt/ros/jazzy/setup.bash && \
    colcon build \
      --symlink-install \
      --packages-select shared_msgs && \
    source /ros2_ws/install/setup.bash && \
    colcon build \
      --symlink-install \
      --packages-skip shared_msgs

# ── Entrypoint ─────────────────────────────────────────────────────────────────
# ROBOT_NAMESPACE must be set (e.g. robot3).
# ROSBRIDGE_URL points at the fleet's rosbridge; unset runs local-only.
CMD ["/ros2_ws/scripts/robot3_entrypoint.sh"]
