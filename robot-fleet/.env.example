# ── Robot fleet scaling ───────────────────────────────────────────────────────
# Copy this file to .env to override the defaults baked into docker-compose.yml.
#
# ROBOT_COUNT is the single knob controlling how many robots Nav2 serves.
# It must match the number of robotN service blocks in docker-compose.yml.
# The backend does NOT read this — it discovers live robots via /rosapi/topics.
ROBOT_COUNT=2
