# systemd unit file.
# Tells Linux how to run and manage the Spring Boot backend as a background service
# — including when to start it and what to do if it crashes.

[Unit]
Description=DishPatch Spring Boot Backend
After=network.target rosbridge.service
Requires=rosbridge.service

[Service]
ExecStart=java -jar /opt/dishpatch/backend.jar
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
